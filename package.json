{
  "name": "troupe-run-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "docs:sync": "node scripts/troupe-docs.mjs",
    "build": "astro build",
    "build:fixture": "node scripts/troupe-fixture.mjs",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,mts,mjs,js,astro,css}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "assets:render": "node scripts/render-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "linkcheck": "node scripts/linkcheck.mjs",
    "linkcheck:external": "node scripts/linkcheck-external.mjs",
    "test:rebuild": "node scripts/rebuild-test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/starlight": "0.42.11",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "astro": "7.4.7",
    "starlight-blog": "0.30.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "linkinator": "8.1.0",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
